# CorpIntel AI Backend Environment Configuration

# Server settings
HOST=0.0.0.0
PORT=8000
ENVIRONMENT=development

# Allowed CORS Origins (comma-separated)
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173

# AI Provider Settings
# If GEMINI_API_KEY is left empty, CorpIntel AI will automatically run in High-Fidelity Demo Mode
# with explicitly labeled sample intelligence datasets.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-1.5-flash

# Optional OpenAI compatible provider (e.g., openai, groq, local ollama)
# OPENAI_API_KEY=
# OPENAI_BASE_URL=
# OPENAI_MODEL=gpt-4o-mini
